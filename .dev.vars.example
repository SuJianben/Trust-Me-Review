# Never commit real credentials. Copy to .dev.vars for local development.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
SHOPIFY_API_KEY=
VITE_SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
TURNSTILE_SECRET=
APP_URL=https://your-tunnel.example.com
TOKEN_SECRET=replace-with-at-least-32-random-characters
