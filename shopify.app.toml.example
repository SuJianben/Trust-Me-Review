client_id = "REPLACE_WITH_SHOPIFY_CLIENT_ID"
name = "Trust Me Review"
application_url = "https://REPLACE_WITH_WORKER_DOMAIN"
embedded = true

[auth]
redirect_urls = ["https://REPLACE_WITH_WORKER_DOMAIN/auth/callback"]

[access_scopes]
scopes = "read_products,read_orders,read_fulfillments"

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = ["orders/fulfilled", "app/uninstalled", "customers/data_request", "customers/redact", "shop/redact"]
uri = "/webhooks/shopify"
