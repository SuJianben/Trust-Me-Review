<div class="tmr-star-badge" data-tmr-stars data-product-id="{{ product.id }}" data-shop="{{ shop.permanent_domain }}" data-api="{{ block.settings.api_origin }}" aria-live="polite">
  <span class="tmr-stars" aria-hidden="true">★★★★★</span><a href="#trust-me-review-widget" class="tmr-count"></a>
</div>
{{ 'trust-me-review.css' | asset_url | stylesheet_tag }}
<script src="{{ 'trust-me-review.js' | asset_url }}" defer></script>
{% schema %}
{"name":"Trust Me Review rating","target":"section","settings":[{"type":"text","id":"api_origin","label":"App API origin","info":"Your deployed Trust Me Review Worker URL"}]}
{% endschema %}
